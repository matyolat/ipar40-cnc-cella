 {
  "id": "f_r",
  "type": "function",
  "z": "tab1",
  "name": "riasztás formázás",
  "func": "const r = msg.payload;\nconst nevek = {\n    orso_hom_C: \"Orsó túlmelegedés\",\n    rezges_mm_s: \"Nagy rezgés\",\n    gephiba: \"Géphiba (leállt)\",\n    kapcsolat: \"Kapcsolatkiesés\"\n};\nconst nev = nevek[r.tipus] || r.tipus;\nconst ido = new Date(r.ts * 1000).toLocaleTimeString(\"hu-HU\");\nlet sor = {\n    \"Idő\": ido,\n    \"Riasztás\": nev,\n    \"Állapot\": r.allapot == \"be\" ? \"AKTÍV\" : \"megszűnt\",\n    \"Érték\": r.ertek == null ? \"\" : String(r.ertek)\n};\nlet lista = context.get(\"lista\") || [];\nlista.unshift(sor);\nlista = lista.slice(0, 15);\ncontext.set(\"lista\", lista);\n\nlet ertesites = null;\nif (r.allapot == \"be\") {\n    ertesites = { payload: ido + \" - \" + nev + (r.ertek != null ? \" (\" + r.ertek + \")\" : \"\") };\n}\nreturn [{ payload: lista }, ertesites];",
  "outputs": 2,
  "timeout": 0,
  "noerr": 0,
  "initialize": "",
  "finalize": "",
  "libs": [],
  "x": 400,
  "y": 880,
  "wires": [
   [
    "tbl_r"
   ],
   [
    "notif"
   ]
  ]
 },
